{
  "name": "@bottifact/react",
  "version": "0.2.0",
  "description": "Typed React components for Bottifact artifacts",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "licenses"
  ],
  "exports": {
    ".": {
